# ──────────────────────────────────────────────────────────
# Groq API (LLM inference)
# ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ──────────────────────────────────────────────────────────
# Tavily (web search for CRAG)
# ──────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────
# Optional LLM overrides (e.g. OpenAI, xAI)
# ──────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_llm_api_key_here

# ──────────────────────────────────────────────────────────
# WhatsApp Bot — Meta Business Cloud API (Production)
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup
# ──────────────────────────────────────────────────────────
META_VERIFY_TOKEN=sellsmart_verify_token_2026
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Your WhatsApp Business phone number (E.164, no +), e.g. 919876543210
# This is shown to farmers when they want to message the bot
WA_BUSINESS_NUMBER=

# ──────────────────────────────────────────────────────────
# WhatsApp Bot — Twilio (Sandbox / Production)
# Get these from: console.twilio.com → Account Info
# Only needed if you use Twilio instead of / in addition to Meta
# ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
