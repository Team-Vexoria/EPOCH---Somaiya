# ──────────────────────────────────────────────────────────
# Groq API (LLM inference)
# ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ──────────────────────────────────────────────────────────
# Tavily (web search for CRAG)
# ──────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────
# Optional LLM overrides (e.g. OpenAI, xAI)
# ──────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_llm_api_key_here

# ──────────────────────────────────────────────────────────
# WhatsApp Bot — Meta Business Cloud API (Production & Test)
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup
# ──────────────────────────────────────────────────────────
WA_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=
VERIFY_TOKEN=sellsmart_verify_2026
GRAPH_VERSION=v25.0
CHAT_API_URL=http://localhost:8000/ask
PORT=3000

# Meta Backwards-compatible aliases
META_VERIFY_TOKEN=sellsmart_verify_2026
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WA_BUSINESS_NUMBER=

# ──────────────────────────────────────────────────────────
# WhatsApp Bot — Twilio (Sandbox / Production)
# Get these from: console.twilio.com → Account Info
# ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
